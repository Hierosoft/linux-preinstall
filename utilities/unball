#!/usr/bin/env python3
"""
Extract archives supported by the Python standard library without
redundant subdirectories or multiple subdirectories (output multiple
under a new directory, otherwise extract directly but do not place under
existing directory if present).

Options:
--overwrite             Allow overwriting files in the destination.
"""
from __future__ import print_function
from collections import OrderedDict
import logging
import os
import shutil
import sys
import tarfile
import tempfile
import zipfile

logger = logging.getLogger(__name__)


def extract_zip(archive_path, tmp_path):
    """Extract a ZIP archive into tmp_path using the zipfile module."""
    with zipfile.ZipFile(archive_path, "r") as zf:
        zf.extractall(tmp_path)


def extract_tar(archive_path, tmp_path):
    """Extract a tar archive (plain or compressed) into tmp_path using tarfile."""
    with tarfile.open(archive_path, "r:*") as tf:
        tf.extractall(tmp_path)


def get_extractor(archive_path):
    """Return the extract function that matches the archive's module."""
    lower = archive_path.lower()
    if lower.endswith(".zip"):
        return extract_zip
    if (
        lower.endswith(".tar")
        or lower.endswith(".tar.gz")
        or lower.endswith(".tgz")
        or lower.endswith(".tar.bz2")
        or lower.endswith(".tbz2")
        or lower.endswith(".tar.xz")
        or lower.endswith(".txz")
        or lower.endswith(".tar.lzma")
    ):
        return extract_tar
    raise ValueError("Unsupported archive type: {}".format(archive_path))


def move_as(src, dst, overwrite=False):
    """shutil.move wrapped to avoid nested directories
    (similar to rsync --remove-source-files)"""
    if os.path.isfile(dst):
        if os.path.isfile(src) and overwrite:
            logger.warning("Overwriting {}".format(repr(dst)))
            os.remove(dst)
            shutil.move(src, dst)
            return
        raise TypeError(
            "Expected directory or new directory path, got file {}."
            "Enable overwrite to allow overwriting with {}"
            .format(repr(dst), repr(src)))
    if os.path.islink(dst):
        if not os.path.exists(dst):
            raise TypeError(
                "dst is a bad symlink {}"
                .format(repr(dst)))
    if os.path.realpath(src) == os.path.realpath(dst):
        raise ValueError("src and dst are the same: {}"
                         .format(dst))
    if not os.path.exists(dst):
        shutil.move(src, dst)
        return
    # else avoid moving it into the dst
    # (unexpected extra nesting level):
    for sub in os.listdir(src):
        move_as(os.path.join(src, sub), os.path.join(dst, sub),
                overwrite=overwrite)
    os.rmdir(src)


def extract_archive(this_archive_path, output_dir=None,
                    overwrite=False):
    """Extract one archive via a temporary directory,
    then move the result.

    Extract archives supported by the Python standard library.

    Avoid redundant subdirectories or multiple subdirectories (output
    multiple under a new directory, or one under output_dir).

    Args:
        this_archive_path (str): source
        output_dir (str, optional): _description_. Defaults to None.
        overwrite (bool, optional): _description_. Defaults to False.

    Returns:
        OrderedDict(str, str): Destination stats
            - 'destination' (str): where extracted
            - 'depth' (str): 0 if only 1 file/folder in archive
              (extracted as dst, so no depth added to dst), 1 if
              multiple files/folders were placed under dst (depth of dst
              increased by 1)
    """
    if output_dir is None:
        base_name = os.path.split(this_archive_path)[1]
        output_dir = os.path.join(
            os.getcwd(), os.path.splitext(base_name)[0]
        )

    extractor = get_extractor(this_archive_path)
    tmp_path = tempfile.mkdtemp()
    extractor(this_archive_path, tmp_path)

    tmp_subs = list(os.listdir(tmp_path))
    results = OrderedDict()
    results["depth"] = 1
    if len(tmp_subs) == 1:
        move_as(os.path.join(tmp_path, tmp_subs[0]), output_dir,
                overwrite=overwrite)
        results["depth"] = 0
        os.rmdir(tmp_path)
    else:
        move_as(tmp_path, output_dir, overwrite=overwrite)
    results["destination"] = output_dir
    return results


def dumpDict(d):
    for key, value in d.items():
        print("{}={}".format(key, repr(value)))


def usage():
    print()
    print("unball")
    print("------")
    print(__doc__.lstrip())


def main():
    """Process command-line arguments and extract each archive."""
    logging.basicConfig(
        level=logging.INFO, format="%(levelname)s: %(message)s"
    )
    args = sys.argv[1:]
    if not args:
        logger.error("No archive paths provided")
        return 1

    overwrite = False
    for i in reversed(range(1, len(args))):
        if args[i].startswith("--"):
            if args[i] == "--overwrite":
                overwrite = True
            else:
                usage()
                logger.fatal("unrecognized option: {}".format(args[i]))
                return 1
            del args[i]

    try:
        if len(args) > 1:
            last_arg = args[-1]
            if os.path.isfile(last_arg):
                logger.error(
                    "When more than one argument is given, the last must be "
                    "a directory (existing or not), not a file: %s",
                    last_arg,
                )
                return 1
            output_dir = last_arg
            for archive_path in args[:-1]:
                results = extract_archive(archive_path, output_dir,
                                        overwrite=overwrite)
                dumpDict(results)
        else:
            results = extract_archive(args[0], overwrite=overwrite)
            dumpDict(results)
    except Exception:
        usage()
        raise

    return 0


if __name__ == "__main__":
    sys.exit(main())
